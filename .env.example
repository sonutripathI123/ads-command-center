# Copy to backend/.env for local development. Never commit real values.
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+psycopg://ads:ads@localhost:5432/ads_command_center
REDIS_URL=redis://localhost:6379/0

# Live Google Ads mutations are impossible while this is true (P17 kill switch).
ADS_EXECUTION_KILL_SWITCH=true

APP_SECRET_KEY=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
