# Copy to plain `.env` at the repo root (that exact name is already gitignored — see .gitignore's
# ".env" / "*.env" rules), fill in every value, then:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# Never commit the filled-in file. Generate APP_SECRET_KEY / CREDENTIALS_ENCRYPTION_KEY / POSTGRES_PASSWORD
# fresh for production — do not reuse whatever is in backend/.env on your dev machine.
#   Generate a random secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Domain: ONE host serves the dashboard and the API (/api/*) ----
APP_DOMAIN=app.yourdomain.com.au

# ---- Core (P00) ----
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true
# Long random string — the app refuses to start in production with the default value.
APP_SECRET_KEY=
# Comma-separated in code as a list; set to your real frontend origin(s), e.g. https://app.yourdomain.com.au
CORS_ORIGINS=["https://app.yourdomain.com.au"]

# Live Google Ads mutations are impossible while this is true. Leave it true —
# nothing in this build should ever need it set to false (P17 execution isn't built yet).
ADS_EXECUTION_KILL_SWITCH=true

# ---- Database / cache ----
POSTGRES_PASSWORD=
# REDIS_URL is set automatically by docker-compose.prod.yml; leave unset here.

# ---- P04 Google Ads Connection ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
# Must match the redirect URI registered in the Google Cloud OAuth client, on your real domain:
GOOGLE_ADS_OAUTH_REDIRECT_URI=https://app.yourdomain.com.au/api/v1/ads-connection/oauth/callback
FRONTEND_URL=https://app.yourdomain.com.au
# Random 32-byte key (Fernet) that encrypts stored OAuth refresh tokens at rest. Required in production —
# there is no dev fallback derivation once APP_ENV=production.
#   Generate one:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ---- P06 Analytics (GA4 + Search Console) ----
# Path INSIDE the backend container. Mount the real file read-only via a compose volume, e.g.:
#   backend: { volumes: ["./secrets/gsc-service-account.json:/srv/backend/secrets/gsc-service-account.json:ro"] }
GOOGLE_SERVICE_ACCOUNT_FILE=/srv/backend/secrets/gsc-service-account.json

# ---- P09/P10/P11/P14 AI (Claude) ----
ANTHROPIC_API_KEY=

# ---- Frontend build arg (read by docker-compose.prod.yml, not by the backend container) ----
# Baked into the frontend bundle at build time — the browser calls this URL directly.
NEXT_PUBLIC_API_URL=https://app.yourdomain.com.au

# ---- P24 Production Hardening (optional — sane defaults if left unset) ----
# RATE_LIMIT_PER_MINUTE=300
# RATE_LIMIT_WINDOW_SECONDS=60
