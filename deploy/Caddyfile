# Reverse proxy + automatic HTTPS (Let's Encrypt) — ONE domain for everything.
# APP_DOMAIN comes from .env (e.g. app.yourdomain.com.au); its DNS A record must point at this server.
#   /api/*  -> backend (FastAPI)       everything else -> frontend (Next.js)
# One host on purpose: the login cookie is host-only, so the app and the API must share a host
# (separate app./api. subdomains would make the frontend's route guard never see the cookie -> login loop).

{$APP_DOMAIN} {
	encode gzip

	@api path /api/*
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
